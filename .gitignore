__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/
tmp/

# Docker
docker-compose.override.yml
